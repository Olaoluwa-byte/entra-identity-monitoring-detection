index=entra_id sourcetype=entra:audit result=success
    activityDisplayName="*Certificates and secrets management*"
| eval upn='initiatedBy.user.userPrincipalName', appname='initiatedBy.app.displayName'
| eval actor=case(isnotnull(upn) AND upn!="null", upn,
                  isnotnull(appname) AND appname!="null", appname,
                  true(), "unknown")
| eval target_app=mvindex('targetResources{}.displayName',0),
       target_id=mvindex('targetResources{}.id',0),
       operation=trim(activityDisplayName),
       src_ip='initiatedBy.user.ipAddress'
| rex field="targetResources{}.modifiedProperties{}.newValue" "KeyType=(?<key_type>\w+)"
| eval key_type=coalesce(key_type,"not logged"),
       cred_context=if(like(operation,"Create application%"),"added at app creation","added to existing app")
| lookup entra_known_apps.csv target_id OUTPUT approved_actor
| where isnull(approved_actor) OR approved_actor!=actor
| stats earliest(_time) as _time values(operation) as operation values(key_type) as key_type
        values(cred_context) as cred_context values(src_ip) as src_ip
        by correlationId actor target_app target_id
